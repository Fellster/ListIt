rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAnonymous() {
      return signedIn() &&
        request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function authEmail() {
      return signedIn() ? request.auth.token.email : null;
    }

    function normalizedAuthEmail() {
      return authEmail().lower().trim().replace('.', '_');
    }

    function isOwner(listData) {
      return signedIn() && listData.ownerId == request.auth.uid;
    }

    function isMember(listData) {
      return signedIn() && (
        listData.ownerId == request.auth.uid ||
        request.auth.uid in listData.get('members', []) ||
        (
          authEmail() != null &&
          authEmail().lower().trim() in listData.get('memberEmails', [])
        )
      );
    }

    function isEditor(listData) {
      return signedIn() && (
        listData.ownerId == request.auth.uid ||
        (
          authEmail() != null &&
          listData.get(
            ['sharedWith', normalizedAuthEmail(), 'role'],
            ''
          ) == 'editor'
        )
      );
    }

    function editorListUpdateOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'title',
        'description',
        'color',
        'icon',
        'heading',
        'type',
        'isPinned',
        'isArchived',
        'updatedAt',
        'itemCount',
        'completedCount'
      ]);
    }

    match /users/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    match /lists/{listId} {
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.auth.uid in request.resource.data.get('members', [])
        && request.resource.data.get('memberEmails', []).size() == 0
        && (
          isAnonymous() ||
          request.resource.data.get('ownerEmail', '').lower().trim()
            == authEmail().lower().trim()
        );

      allow read: if isMember(resource.data);

      allow update: if isOwner(resource.data)
        || (
          isEditor(resource.data)
          && editorListUpdateOnly()
        );

      allow delete: if isOwner(resource.data);

      match /items/{itemId} {
        allow read: if isMember(get(/databases/$(database)/documents/lists/$(listId)).data);

        allow create: if isEditor(
          get(/databases/$(database)/documents/lists/$(listId)).data
        )
        && request.resource.data.listId == listId;

        allow update, delete: if isEditor(
          get(/databases/$(database)/documents/lists/$(listId)).data
        );

        allow update: if isEditor(
          get(/databases/$(database)/documents/lists/$(listId)).data
        )
        && request.resource.data.listId == listId;
      }

      match /activity/{activityId} {
        allow read: if isMember(
          get(/databases/$(database)/documents/lists/$(listId)).data
        );

        allow create: if isMember(
          get(/databases/$(database)/documents/lists/$(listId)).data
        )
        && request.resource.data.listId == listId
        && (
          isAnonymous() ||
          (
            request.resource.data.get('userEmail', '').lower().trim()
              == authEmail().lower().trim()
          )
        );

        allow update, delete: if isOwner(
          get(/databases/$(database)/documents/lists/$(listId)).data
        );
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}