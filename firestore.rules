rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User profiles
    match /users/{userId} {
      allow read, write: if true;
    }

    // Lists collection and subcollections
    match /lists/{listId} {
      allow read, write: if true;

      // Items subcollection
      match /items/{itemId} {
        allow read, write: if true;
      }

      // Activity logs subcollection
      match /activity/{activityId} {
        allow read, write: if true;
      }
    }
  }
}

