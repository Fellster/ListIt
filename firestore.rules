rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isListOwner(listData) {
      return isAuthenticated() && (listData.ownerId == request.auth.uid || listData.ownerEmail == request.auth.token.email);
    }
    
    function isListMember(listData) {
      return isAuthenticated() && (
        listData.ownerId == request.auth.uid || 
        listData.ownerEmail == request.auth.token.email ||
        (listData.members != null && (request.auth.uid in listData.members || request.auth.token.email in listData.members)) ||
        (listData.memberEmails != null && request.auth.token.email in listData.memberEmails)
      );
    }

    function canEditList(listData) {
      return isAuthenticated() && (
        isListOwner(listData) ||
        (listData.sharedWith != null && (
          (listData.sharedWith[request.auth.uid] != null && listData.sharedWith[request.auth.uid].role == 'editor') ||
          (listData.sharedWith[request.auth.token.email] != null && listData.sharedWith[request.auth.token.email].role == 'editor')
        ))
      );
    }

    // User profiles
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }

    // Lists collection
    match /lists/{listId} {
      allow read: if isAuthenticated() && (
        resource == null || 
        resource.data.ownerId == request.auth.uid || 
        resource.data.ownerEmail == request.auth.token.email ||
        (resource.data.memberEmails != null && request.auth.token.email in resource.data.memberEmails) ||
        (resource.data.members != null && (request.auth.uid in resource.data.members || request.auth.token.email in resource.data.members))
      );
      
      allow create: if isAuthenticated();
      
      allow update: if isAuthenticated() && (
        isListOwner(resource.data) || canEditList(resource.data)
      );
      
      allow delete: if isAuthenticated() && isListOwner(resource.data);

      // Items subcollection
      match /items/{itemId} {
        allow read: if isAuthenticated();
        allow create, update, delete: if isAuthenticated();
      }

      // Activity logs subcollection
      match /activity/{activityId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated();
      }
    }
  }
}
